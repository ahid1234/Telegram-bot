import logging
import requests
from telegram import Update
from telegram.ext import Application, CommandHandler, CallbackContext

TOKEN = "YOUR_TELEGRAM_BOT_TOKEN"

# Simple function to get market price (Dummy API used)
def get_market_price():
    response = requests.get("https://api.example.com/market-price")  # Replace with actual API
    data = response.json()
    return data["price"]

# Determine trend (Simple logic)
def check_trend():
    price_now = get_market_price()
    moving_avg = 100  # Example Moving Average (This should be dynamic)
    return "⬆️ UP" if price_now > moving_avg else "⬇️ DOWN"

# Telegram command handler
async def start(update: Update, context: CallbackContext):
    trend = check_trend()
    await update.message.reply_text(f"Market Trend: {trend}")

# Main function to run bot
def main():
    app = Application.builder().token(TOKEN).build()
    app.add_handler(CommandHandler("start", start))
    
    print("Bot is running...")
    app.run_polling()

